{
  "schema": "malleus.temporal-g1-specimen/draft-1",
  "specimen_id": "G1-08-STORAGE-CLOSURE",
  "obligation": ["FULL_GRAPH_ROUND_TRIP", "REPLAY_REBUILD", "MISSING_CLOSURE_REFUSES", "FAILED_WRITE_NO_PARTIAL_STATE"],
  "origin": {
    "flows": ["GE-05", "GE-10", "GE-12"],
    "basis": "SYNTHETIC",
    "note": "Grouped because all four obligations are about storage and replay mechanics, not temporal meaning. Literals are chosen to break lossy encodings: a numeric-looking string, a decimal with a trailing zero, a known-open period next to an unstated one, a directed relation, and two models that share terms."
  },
  "objects": [
    {"id": "contract:c1", "type": "CONTRACT", "version": "1", "identity": "synthetic-contract-c1"},
    {"id": "part:X", "type": "SUBJECT", "label": "Part X", "contract_ref": "contract:c1"},
    {"id": "assembly:A", "type": "SUBJECT", "label": "Assembly A", "contract_ref": "contract:c1"},
    {"id": "src:quote", "type": "SOURCE", "source_kind": "SYNTHETIC_TEXT",
     "text": "Part X, part number 0750, belongs to assembly A. It costs 5.40 EUR per unit from 2026-05-01T00:00:00Z. Quantity ordered: 3."},
    {"id": "q-partno", "type": "ASSERTION", "subject_ref": "part:X", "property": "part_number", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:string", "lexical": "0750"}, "basis": "REPORTED",
     "applicability": {"kind": "NONE_STATED"}, "evidence_refs": ["src:quote"]},
    {"id": "q-price", "type": "ASSERTION", "subject_ref": "part:X", "property": "unit_price", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:decimal", "lexical": "5.40", "unit": "EUR"}, "basis": "REPORTED",
     "applicability": {"kind": "INTERVAL", "from": "2026-05-01T00:00:00Z", "until": null}, "evidence_refs": ["src:quote"]},
    {"id": "q-qty", "type": "ASSERTION", "subject_ref": "part:X", "property": "quantity", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:integer", "lexical": "3", "unit": "item"}, "basis": "REPORTED",
     "applicability": {"kind": "NONE_STATED"}, "evidence_refs": ["src:quote"]},
    {"id": "rel:part-of", "type": "RELATION", "relation_type": "PART_OF", "from_ref": "part:X", "to_ref": "assembly:A", "contract_ref": "contract:c1",
     "basis": "REPORTED", "evidence_refs": ["src:quote"]},
    {"id": "term:quantity", "type": "SUBJECT", "label": "quantity"},
    {"id": "term:unit-price", "type": "SUBJECT", "label": "unit price"},
    {"id": "term:fee", "type": "SUBJECT", "label": "handling fee"},
    {"id": "model:m1", "type": "MODEL", "version": "1", "implementation": "synthetic-line-total@1",
     "formula": "total = quantity * unit_price", "parameters": ["quantity", "unit_price"],
     "member_refs": ["term:quantity", "term:unit-price"]},
    {"id": "model:m2", "type": "MODEL", "version": "2", "implementation": "synthetic-line-total@2",
     "formula": "total = quantity * unit_price + fee", "parameters": ["quantity", "unit_price", "fee"],
     "member_refs": ["term:quantity", "term:unit-price", "term:fee"]},
    {"id": "exec:e1", "type": "EXECUTION", "model_ref": "model:m1",
     "input_bindings": [{"parameter": "quantity", "assertion_ref": "q-qty"}, {"parameter": "unit_price", "assertion_ref": "q-price"}]},
    {"id": "result:e1", "type": "RESULT", "execution_ref": "exec:e1", "value": {"datatype": "xsd:decimal", "lexical": "16.20", "unit": "EUR"}}
  ],
  "changes": [
    {"position": "R0", "kind": "GENESIS", "adds_refs": []},
    {"position": "R1", "kind": "CONTRACT_DECLARATION", "adds_refs": ["contract:c1"]},
    {"position": "R2", "kind": "REPORT", "adds_refs": ["part:X", "assembly:A", "src:quote", "q-partno", "q-price", "q-qty", "rel:part-of"]},
    {"position": "R3", "kind": "MODEL_DEFINITION", "adds_refs": ["term:quantity", "term:unit-price", "term:fee", "model:m1", "model:m2"]},
    {"position": "R4", "kind": "EXECUTION_RECORD", "adds_refs": ["exec:e1", "result:e1"]}
  ],
  "queries": [
    {"id": "ST01", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "q-price"},
     "expected": {"state": "EXACT_OBJECT", "value": {"datatype": "xsd:decimal", "lexical": "5.40", "unit": "EUR"},
                  "applicability": {"kind": "INTERVAL", "from": "2026-05-01T00:00:00Z", "until": null}, "evidence_refs": ["src:quote"]}},
    {"id": "ST02", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "q-partno"},
     "expected": {"state": "EXACT_OBJECT", "value": {"datatype": "xsd:string", "lexical": "0750"}, "applicability": {"kind": "NONE_STATED"}}},
    {"id": "ST03", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "q-qty"},
     "expected": {"state": "EXACT_OBJECT", "value": {"datatype": "xsd:integer", "lexical": "3", "unit": "item"}, "applicability": {"kind": "NONE_STATED"}}},
    {"id": "ST04", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "rel:part-of"},
     "expected": {"state": "EXACT_OBJECT", "metadata": [{"ref": "rel:part-of", "from_ref": "part:X", "to_ref": "assembly:A", "relation_type": "PART_OF"}]}},
    {"id": "ST05", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "model:m1"},
     "expected": {"state": "EXACT_OBJECT", "visible_refs": ["term:quantity", "term:unit-price"]}},
    {"id": "ST06", "kind": "EXACT_LOOKUP", "inputs": {"at": "R4", "target_ref": "model:m2"},
     "expected": {"state": "EXACT_OBJECT", "visible_refs": ["term:quantity", "term:unit-price", "term:fee"]}},
    {"id": "ST07", "kind": "EXPLAIN_EXECUTION", "inputs": {"at": "R4", "execution_ref": "exec:e1"},
     "expected": {"state": "ORIGINAL_PREMISES_PRESERVED", "premise_refs": ["q-qty", "q-price"], "model_ref": "model:m1",
                  "result_ref": "result:e1", "value": {"datatype": "xsd:decimal", "lexical": "16.20", "unit": "EUR"}}},
    {"id": "ST08", "kind": "EXPLAIN_EXECUTION", "note": "Rebuild with the source bytes unavailable.",
     "inputs": {"at": "R4", "execution_ref": "exec:e1", "withheld_refs": ["src:quote"]},
     "expected": {"state": "INCOMPLETE_RECONSTRUCTION", "missing_refs": ["src:quote"]}},
    {"id": "ST09", "kind": "EXPLAIN_EXECUTION", "note": "Rebuild with the model definition unavailable.",
     "inputs": {"at": "R4", "execution_ref": "exec:e1", "withheld_refs": ["model:m1"]},
     "expected": {"state": "INCOMPLETE_RECONSTRUCTION", "missing_refs": ["model:m1"]}},
    {"id": "ST10", "kind": "EXACT_LOOKUP", "note": "Rebuild with the governing contract unavailable.",
     "inputs": {"at": "R4", "target_ref": "q-price", "withheld_refs": ["contract:c1"]},
     "expected": {"state": "INCOMPLETE_RECONSTRUCTION", "missing_refs": ["contract:c1"]}},
    {"id": "ST11", "kind": "EXPLAIN_EXECUTION", "note": "Rebuild with a model this execution did not use unavailable.",
     "open_choice_ref": "OC-08-WITHHELD-SCOPE",
     "inputs": {"at": "R4", "execution_ref": "exec:e1", "withheld_refs": ["model:m2"]},
     "expected": null},
    {"id": "ST12", "kind": "INSPECT_HISTORY", "note": "After the refused two-operation write.",
     "inputs": {"at": "R4", "subject_ref": "part:X", "after_refusal_ref": "RF-PARTIAL"},
     "expected": {"state": "QUALIFIED_HISTORY", "visible_refs": ["q-partno", "q-price", "q-qty", "rel:part-of"], "absent_refs": ["q-weight", "rel:bad"]}},
    {"id": "ST13", "kind": "EXACT_LOOKUP", "note": "Head position after every refusal.",
     "inputs": {"at": "R4", "target_ref": "result:e1", "after_refusal_ref": "RF-UNSUPPORTED"},
     "expected": {"state": "EXACT_OBJECT", "value": {"datatype": "xsd:decimal", "lexical": "16.20", "unit": "EUR"}}}
  ],
  "phantom_ids": ["phantom:subject", "phantom:model", "phantom:contract"],
  "rejected_objects": [
    {"id": "q-weight", "type": "ASSERTION", "subject_ref": "part:X", "property": "weight", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:decimal", "lexical": "0.25", "unit": "kg"}, "basis": "REPORTED",
     "applicability": {"kind": "NONE_STATED"}, "evidence_refs": ["src:quote"]},
    {"id": "rel:bad", "type": "RELATION", "relation_type": "PART_OF", "from_ref": "part:X", "to_ref": "phantom:subject"},
    {"id": "exec:bad", "type": "EXECUTION", "model_ref": "phantom:model",
     "input_bindings": [{"parameter": "quantity", "assertion_ref": "q-qty"}]},
    {"id": "q-corr", "type": "ASSERTION", "subject_ref": "part:X", "property": "unit_price", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:decimal", "lexical": "5.60", "unit": "EUR"}, "basis": "CORRECTION", "corrects_ref": "q-price",
     "applicability": {"kind": "INTERVAL", "from": "2026-05-01T00:00:00Z", "until": null}, "evidence_refs": []},
    {"id": "q-recurring", "type": "ASSERTION", "subject_ref": "part:X", "property": "unit_price", "contract_ref": "contract:c1",
     "value": {"datatype": "xsd:decimal", "lexical": "5.00", "unit": "EUR"}, "basis": "REPORTED",
     "applicability": {"kind": "RECURRING", "rule": "every Monday"}, "evidence_refs": ["src:quote"]},
    {"id": "q-foreign", "type": "ASSERTION", "subject_ref": "part:X", "property": "colour", "contract_ref": "phantom:contract",
     "value": {"datatype": "xsd:string", "lexical": "grey"}, "basis": "REPORTED",
     "applicability": {"kind": "NONE_STATED"}, "evidence_refs": ["src:quote"]}
  ],
  "refusals": [
    {"id": "RF-PARTIAL", "head": "R4", "base": "R4", "category": "UNKNOWN_REFERENCE", "head_after": "R4",
     "operation": "One change with two operations: a valid weight assertion and a relation to an id that does not exist. The whole change refuses.",
     "would_add_refs": ["q-weight", "rel:bad"]},
    {"id": "RF-MISSING-MODEL", "head": "R4", "base": "R4", "category": "MISSING_MODEL", "head_after": "R4",
     "operation": "An execution names a model that was never accepted.", "would_add_refs": ["exec:bad"]},
    {"id": "RF-MISSING-EVIDENCE", "head": "R4", "base": "R4", "category": "MISSING_EVIDENCE", "head_after": "R4",
     "operation": "A correction with no retained source.", "would_add_refs": ["q-corr"], "target_refs": ["q-price"]},
    {"id": "RF-UNSUPPORTED", "head": "R4", "base": "R4", "category": "UNSUPPORTED_SEMANTICS", "head_after": "R4",
     "operation": "An applicability kind the profile does not define (recurrence).", "would_add_refs": ["q-recurring"]},
    {"id": "RF-MISSING-CONTRACT", "head": "R4", "base": "R4", "category": "MISSING_CONTRACT", "head_after": "R4",
     "operation": "An assertion governed by a contract that was never accepted.", "would_add_refs": ["q-foreign"]}
  ],
  "forbidden": [
    {"query_ref": "ST01", "answer": {"value": {"datatype": "xsd:decimal", "lexical": "5.4", "unit": "EUR"}}, "why": "Drops the lexical form; a float round trip is not lossless."},
    {"query_ref": "ST01", "answer": {"applicability": {"kind": "NONE_STATED"}}, "why": "A known-open period is not unstated time."},
    {"query_ref": "ST02", "answer": {"value": {"datatype": "xsd:integer", "lexical": "750"}}, "why": "A numeric-looking string became a number."},
    {"query_ref": "ST03", "answer": {"applicability": {"kind": "INTERVAL", "from": "2026-05-01T00:00:00Z", "until": null}}, "why": "Unstated time borrowed a sibling's period."},
    {"query_ref": "ST04", "answer": {"metadata": [{"ref": "rel:part-of", "from_ref": "assembly:A", "to_ref": "part:X"}]}, "why": "Edge direction lost."},
    {"query_ref": "ST05", "answer": {"visible_refs": ["term:quantity", "term:unit-price", "term:fee"]}, "why": "Shared terms merged the two models."},
    {"query_ref": "ST08", "answer": {"state": "ORIGINAL_PREMISES_PRESERVED"}, "why": "A silently simplified explanation without its evidence."},
    {"query_ref": "ST12", "answer": {"visible_refs": ["q-partno", "q-price", "q-qty", "rel:part-of", "q-weight"]}, "why": "The valid half of a refused change was kept."}
  ],
  "open_choices": [
    {"id": "OC-08-WITHHELD-SCOPE", "question": "Does a missing artifact refuse the whole rebuild, or only the reads whose closure needs it?",
     "affects_query_refs": ["ST11"],
     "branches": [
       {"label": "Only reads whose closure needs it refuse", "expected": {"ST11": {"state": "ORIGINAL_PREMISES_PRESERVED", "premise_refs": ["q-qty", "q-price"], "model_ref": "model:m1",
          "result_ref": "result:e1", "value": {"datatype": "xsd:decimal", "lexical": "16.20", "unit": "EUR"}}}},
       {"label": "Any missing retained artifact refuses the whole rebuild", "expected": {"ST11": {"state": "INCOMPLETE_RECONSTRUCTION", "missing_refs": ["model:m2"]}}}
     ]}
  ]
}
