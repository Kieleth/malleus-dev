{
  "$defs": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "OPERATOR",
            "OVERSEER",
            "MECHANICAL"
          ]
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "commonEntry": {
      "properties": {
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "data": {
          "type": "object"
        },
        "entry_hash": {
          "$ref": "#/$defs/digest"
        },
        "entry_id": {
          "pattern": "^OVR-[0-9]{6}$",
          "type": "string"
        },
        "entry_type": {
          "enum": [
            "DECISION",
            "WORKSTREAM_STATE",
            "DOCUMENT_REVISION",
            "VERIFIED_FACT",
            "OBSERVATION",
            "COORDINATION",
            "CORRECTION"
          ]
        },
        "ledger": {
          "const": "overseer"
        },
        "previous_entry_hash": {
          "oneOf": [
            {
              "const": "GENESIS"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "recorded_at": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "schema": {
          "const": "malleus.contract-compiler.ledger-entry/v1"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "summary": {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        "why": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "ledger",
        "sequence",
        "entry_id",
        "entry_type",
        "recorded_at",
        "actor",
        "subject",
        "summary",
        "why",
        "references",
        "data",
        "previous_entry_hash",
        "entry_hash"
      ],
      "type": "object"
    },
    "coordinationData": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "constraints": {
          "$ref": "#/$defs/shortStrings"
        },
        "task_id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "action",
        "constraints"
      ],
      "type": "object"
    },
    "decisionData": {
      "additionalProperties": false,
      "properties": {
        "canonical_record_uris": {
          "items": {
            "format": "uri",
            "type": "string"
          },
          "maxItems": 12,
          "type": "array",
          "uniqueItems": true
        },
        "consequences": {
          "$ref": "#/$defs/shortStrings"
        },
        "constraints": {
          "$ref": "#/$defs/shortStrings"
        },
        "decision_id": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "satisfies_workstreams": {
          "items": {
            "pattern": "^CC-[A-Z0-9]+$",
            "type": "string"
          },
          "maxItems": 12,
          "type": "array",
          "uniqueItems": true
        },
        "selected_option": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "supersedes_entry_id": {
          "pattern": "^OVR-[0-9]{6}$",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "state",
        "selected_option",
        "constraints",
        "consequences",
        "canonical_record_uris",
        "satisfies_workstreams"
      ],
      "type": "object"
    },
    "decisionEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "actor": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "const": "operator"
                },
                "type": {
                  "const": "OPERATOR"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            },
            "data": {
              "$ref": "#/$defs/decisionData"
            },
            "entry_type": {
              "const": "DECISION"
            },
            "subject": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "PROGRAM",
                    "DECISION"
                  ]
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "documentChange": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "change": {
                "const": "CREATED"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "not": {
              "required": [
                "before_digest"
              ]
            }
          },
          "else": {
            "required": [
              "before_digest"
            ]
          }
        }
      ],
      "properties": {
        "after_digest": {
          "$ref": "#/$defs/digest"
        },
        "before_digest": {
          "$ref": "#/$defs/digest"
        },
        "change": {
          "enum": [
            "CREATED",
            "MODIFIED",
            "REPLACED"
          ]
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "change",
        "after_digest"
      ],
      "type": "object"
    },
    "documentRevisionData": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "$ref": "#/$defs/shortStrings"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/documentChange"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "documents",
        "affected_ids"
      ],
      "type": "object"
    },
    "factData": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "limitations": {
          "$ref": "#/$defs/shortStrings"
        },
        "claims": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "as_of",
        "claims",
        "limitations"
      ],
      "type": "object"
    },
    "verifiedFactEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/factData"
            },
            "entry_type": {
              "const": "VERIFIED_FACT"
            },
            "subject": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "const": "EVIDENCE"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "head": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "const": "malleus-canonical-json-v1"
        },
        "entry_count": {
          "minimum": 1,
          "type": "integer"
        },
        "hash_grammar": {
          "const": "malleus.contract-compiler.ledger-hash/v1"
        },
        "head_entry_id": {
          "pattern": "^OVR-[0-9]{6}$",
          "type": "string"
        },
        "head_hash": {
          "$ref": "#/$defs/digest"
        },
        "ledger": {
          "const": "overseer"
        },
        "schema": {
          "const": "malleus.contract-compiler.ledger-head/v1"
        }
      },
      "required": [
        "schema",
        "ledger",
        "entry_count",
        "head_entry_id",
        "head_hash",
        "canonicalization",
        "hash_grammar"
      ],
      "type": "object"
    },
    "observationData": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/shortStrings"
        },
        "limitations": {
          "$ref": "#/$defs/shortStrings"
        }
      },
      "required": [
        "as_of",
        "basis",
        "limitations"
      ],
      "type": "object"
    },
    "observationEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/observationData"
            },
            "entry_type": {
              "const": "OBSERVATION"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "coordinationEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/coordinationData"
            },
            "entry_type": {
              "const": "COORDINATION"
            },
            "subject": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "const": "TASK"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "correctionData": {
      "additionalProperties": false,
      "properties": {
        "affected_subject_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "replacement_required": {
          "type": "boolean"
        },
        "supersedes_entry_id": {
          "pattern": "^OVR-[0-9]{6}$",
          "type": "string"
        }
      },
      "required": [
        "supersedes_entry_id",
        "affected_subject_ids",
        "replacement_required"
      ],
      "type": "object"
    },
    "correctionEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/correctionData"
            },
            "entry_type": {
              "const": "CORRECTION"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "evidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "byte_length",
        "sha256"
      ],
      "type": "object"
    },
    "verificationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "method": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "observed": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      },
      "required": [
        "check_id",
        "method",
        "result",
        "observed"
      ],
      "type": "object"
    },
    "verificationReport": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/evidenceArtifact"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "base_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/verificationCheck"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "limitations": {
          "$ref": "#/$defs/shortStrings"
        },
        "recorded_at": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "schema": {
          "const": "malleus.contract-compiler.verification-report/v1"
        },
        "workstream_id": {
          "pattern": "^CC-[A-Z0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "workstream_id",
        "recorded_at",
        "base_commit",
        "artifacts",
        "checks",
        "limitations"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "EVIDENCE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "relation": {
          "enum": [
            "DEFINES",
            "DECIDES",
            "SATISFIES",
            "EVIDENCES",
            "IMPLEMENTS",
            "SUPERSEDES",
            "COORDINATES",
            "CANONICALIZES",
            "AFFECTS"
          ]
        },
        "target": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "DOCUMENT",
            "WORKSTREAM",
            "DECISION",
            "ENTRY",
            "TASK",
            "COMMIT",
            "CANONICAL_URI",
            "EVIDENCE"
          ]
        }
      },
      "required": [
        "relation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "shortStrings": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "PROGRAM",
            "DECISION",
            "WORKSTREAM",
            "DOCUMENT",
            "EVIDENCE",
            "TASK"
          ]
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "workstreamData": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "new_state": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "new_state"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              },
              "evidence_entry_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "bootstrap": {
          "type": "boolean"
        },
        "blockers": {
          "$ref": "#/$defs/shortStrings"
        },
        "deliverables": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "evidence_entry_ids": {
          "items": {
            "pattern": "^OVR-[0-9]{6}$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "new_state": {
          "enum": [
            "PLANNED",
            "ACTIVE",
            "PAUSED",
            "COMPLETE",
            "REJECTED"
          ]
        },
        "previous_state": {
          "enum": [
            "UNRECORDED",
            "PLANNED",
            "ACTIVE",
            "PAUSED",
            "COMPLETE",
            "REJECTED"
          ]
        },
        "workstream_id": {
          "pattern": "^CC-[A-Z0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "workstream_id",
        "bootstrap",
        "previous_state",
        "new_state",
        "deliverables",
        "blockers",
        "evidence_entry_ids"
      ],
      "type": "object"
    },
    "workstreamEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/workstreamData"
            },
            "entry_type": {
              "const": "WORKSTREAM_STATE"
            },
            "subject": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "pattern": "^CC-[A-Z0-9]+$",
                  "type": "string"
                },
                "type": {
                  "const": "WORKSTREAM"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "documentEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/commonEntry"
        },
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/documentRevisionData"
            },
            "entry_type": {
              "const": "DOCUMENT_REVISION"
            },
            "subject": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "const": "DOCUMENT"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$id": "https://malleus.dev/schemas/contract-compiler/overseer-ledger/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/head"
    },
    {
      "$ref": "#/$defs/decisionEntry"
    },
    {
      "$ref": "#/$defs/workstreamEntry"
    },
    {
      "$ref": "#/$defs/documentEntry"
    },
    {
      "$ref": "#/$defs/verifiedFactEntry"
    },
    {
      "$ref": "#/$defs/observationEntry"
    },
    {
      "$ref": "#/$defs/coordinationEntry"
    },
    {
      "$ref": "#/$defs/correctionEntry"
    },
    {
      "$ref": "#/$defs/verificationReport"
    }
  ],
  "title": "Malleus contract compiler overseer ledger",
  "type": "object"
}
