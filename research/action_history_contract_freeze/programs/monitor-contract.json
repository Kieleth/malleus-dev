    "proposal_content_hash": "proposal.content_hash",
    "assessment_outcome": "producer.computed_outcome",
    "reason_codes": "producer.computed_reason_codes",
    "rationale": "producer.computed_rationale",
    "checked_policy_predicates": "producer.computed_checked_predicates",
