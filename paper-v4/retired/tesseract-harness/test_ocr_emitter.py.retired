"""Focused checks for the paper-local OCR emitter."""

from __future__ import annotations

from dataclasses import replace
from hashlib import sha256
import json
from pathlib import Path
import shutil
import struct
import subprocess
import zlib

import pytest

from malleus import __version__ as MALLEUS_VERSION
from malleus.ocr import Bundle, canonical_digest, profile_registry, verify_bundle
from research.ontology_driven_kg_realization.experiments.document_paper import (
    ocr_emitter,
)
from research.ontology_driven_kg_realization.experiments.document_paper.ocr_emitter import (
    OCREmitterError,
    emit,
)


ROOT = Path(__file__).resolve().parents[4]


def _digest(value: bytes) -> str:
    return "sha256:" + sha256(value).hexdigest()


def _png(width: int = 2, height: int = 3) -> bytes:
    def chunk(kind: bytes, data: bytes) -> bytes:
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
        )

    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    scanlines = b"\x00\x00\x00\x00\x00\x00\x00" * height
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", ihdr)
        + chunk(b"IDAT", zlib.compress(scanlines))
        + chunk(b"IEND", b"")
    )


def _write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n")


def _executable(path: Path, source: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(source)
    path.chmod(0o755)


def _fixture(tmp_path: Path) -> tuple[Path, Path, dict[str, Path]]:
    root = tmp_path / "repo"
    root.mkdir()
    shutil.copytree(ROOT / "ontology", root / "ontology")
    source_bytes = b"%PDF-1.4\nstrict fake paper bytes\n"
    source_path = root / "paper-v4/source/paper.pdf"
    source_path.parent.mkdir(parents=True)
    source_path.write_bytes(source_bytes)

    png_hex = _png().hex()
    renderer = root / "tools/pdftoppm"
    _executable(
        renderer,
        f"""#!/usr/bin/env python3
import pathlib
import sys

if sys.argv[1:] == ["-v"]:
    sys.stderr.write("pdftoppm version TEST-1.0\\n")
    raise SystemExit(0)
pathlib.Path(sys.argv[-1] + ".png").write_bytes(bytes.fromhex("{png_hex}"))
""",
    )
    reader = root / "tools/tesseract"
    _executable(
        reader,
        """#!/usr/bin/env python3
import pathlib
import sys

if sys.argv[1:] == ["--version"]:
    sys.stdout.write("tesseract TEST-2.0\\n")
    raise SystemExit(0)
if (pathlib.Path(__file__).parent / "fail.flag").exists():
    sys.stderr.write("forced reader failure\\n")
    raise SystemExit(7)
if (pathlib.Path(__file__).parent / "empty.flag").exists():
    raise SystemExit(0)
sys.stdout.buffer.write(("OCR-CONTENT-" + pathlib.Path(sys.argv[1]).stem + "\\n").encode())
""",
    )
    traineddata = root / "tools/tessdata/eng.traineddata"
    traineddata.parent.mkdir()
    traineddata.write_bytes(b"exact fake traineddata")

    source_id = "source:test-paper"
    source_digest = _digest(source_bytes)
    source_manifest = {
        "schema": "malleus.paper-v4.source-freeze/v1",
        "source_id": source_id,
        "title": "Fixture",
        "authors": ["Fixture Author"],
        "journal": "Fixture Journal",
        "publication_date": "2026-09-02",
        "doi": "10.0000/fixture",
        "landing_url": "https://example.test/fixture",
        "source_url": "https://example.test/fixture.pdf",
        "license": {
            "identifier": "TEST",
            "url": "https://example.test/license",
            "full_text_redistribution": "TEST_ONLY",
            "derived_full_text_publication": "REQUIRES_SEPARATE_RIGHTS_REVIEW",
        },
        "artifact": {
            "path": "paper-v4/source/paper.pdf",
            "media_type": "application/pdf",
            "byte_length": len(source_bytes),
            "sha256": source_digest,
            "pdf_version": "1.4",
            "page_count": 11,
            "encrypted": False,
            "javascript": False,
        },
        "acquisition": {
            "date": "2026-09-02",
            "method": "TEST_FIXTURE",
            "visual_inspection": "TEST_FIXTURE",
        },
    }
    _write_json(root / "paper-v4/source/source-manifest.json", source_manifest)
    ontology = (root / "ontology/domains/ocr.yaml").read_bytes()
    config = {
        "schema": "malleus.paper-v4.ocr-precommit/v1",
        "frozen_at": "2026-09-02T21:21:52Z",
        "status": "FROZEN_BEFORE_RETAINED_READING",
        "source": {
            "manifest": "paper-v4/source/source-manifest.json",
            "source_id": source_id,
            "path": "paper-v4/source/paper.pdf",
            "media_type": "application/pdf",
            "byte_length": len(source_bytes),
            "sha256": source_digest,
            "page_count": 11,
        },
        "malleus_ocr": {
            "malleus_version": MALLEUS_VERSION,
            "profile": "malleus.ocr.evidence_integrity",
            "profile_version": "v0",
            "document_version": 1,
            "ontology_version": "0.1.0",
            "ontology_path": "ontology/domains/ocr.yaml",
            "ontology_sha256": _digest(ontology),
            "registry_content_hash": "sha256:" + profile_registry().content_hash(),
        },
        "source_class": {
            "id": "source-class:test-article-pdf-v1",
            "required_units": [f"page:{page}" for page in range(1, 12)],
            "metric_families": {
                "page_coverage": {"denominator": "declared_units", "threshold": 1.0}
            },
            "temporal_policy": "STATIC_DOCUMENT_ORDER_ONLY",
            "inventory_basis": "test fixture",
            "frozen_at": "2026-09-02T21:21:52Z",
        },
        "renderer": {
            "id": "renderer:test-png-300dpi",
            "executable": str(renderer),
            "version_contains": "pdftoppm version TEST-1.0",
            "binary_sha256": _digest(renderer.read_bytes()),
            "format": "png",
