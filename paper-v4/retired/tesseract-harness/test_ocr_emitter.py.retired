            "reproducibility_status": "TEST_EXACT_BINARIES",
        },
    }
    precommit = root / "paper-v4/experiment/ocr-precommit.json"
    _write_json(precommit, config)
    return (
        root,
        precommit,
        {
            "private": root / "private/run",
            "bundle": root / "paper-v4/experiment/ocr-bundle.json",
            "verification": root / "paper-v4/experiment/ocr-verification.json",
            "source": source_path,
            "renderer": renderer,
            "reader": reader,
        },
    )


def _assert_no_final_outputs(paths: dict[str, Path]) -> None:
    for name in ("private", "bundle", "verification"):
        assert not paths[name].exists(), name


def test_success_emits_eleven_aligned_chains_and_invokes_only_frozen_tools(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    config = json.loads(precommit.read_bytes())
    commands: list[tuple[str, ...]] = []
    run = subprocess.run

    def audited(command, **kwargs):
        commands.append(tuple(command))
        return run(command, **kwargs)

    monkeypatch.setattr(ocr_emitter.subprocess, "run", audited)
    result = emit(root, precommit)

    assert result.bundle_path == paths["bundle"]
    assert result.verification_path == paths["verification"]
    assert result.private_root == paths["private"]
    bundle = Bundle.from_document(json.loads(paths["bundle"].read_bytes()))
    verification = json.loads(paths["verification"].read_bytes())
    checked = verify_bundle(bundle)
    assert checked.conforms and checked.account.complete
    assert len(bundle.rasters) == len(bundle.regions) == len(bundle.attempts) == 11
    assert len(bundle.hypotheses) == len(bundle.selections) == 11
    assert verification["result"]["strict_alignment"] == "PASS"
    assert verification["publication_boundary"]["public_text"] == "DIGEST_ONLY"
    assert b"OCR-CONTENT" not in paths["bundle"].read_bytes()
    assert b"OCR-CONTENT" not in paths["verification"].read_bytes()
    assert len(verification["sidecars"]) == 11
    for sidecars in verification["sidecars"]:
        for label in ("raster", "request", "response", "selected"):
            retained = root / sidecars[label]["path"]
            assert retained.is_file()
            assert _digest(retained.read_bytes()) == sidecars[label]["sha256"]
    sidecar_closure = canonical_digest(verification["sidecars"])
    assert bundle.transport_metadata["retained_sidecars_sha256"] == sidecar_closure
    assert bundle.id == f"bundle:paper-v4:{sidecar_closure.removeprefix('sha256:')}"
    assert len(commands) == 24
    assert {Path(command[0]) for command in commands} == {
        paths["renderer"],
        paths["reader"],
    }
    renderer_commands = [
        command for command in commands if Path(command[0]) == paths["renderer"]
    ]
    assert renderer_commands[0] == (str(paths["renderer"]), "-v")
    render_commands = renderer_commands[1:]
    assert len(render_commands) == 11
    for page, command in enumerate(render_commands, 1):
        prefix = command[-1]
        assert command == (
            str(paths["renderer"]),
            "-f",
            str(page),
            "-l",
            str(page),
            *config["renderer"]["single_page_arguments"],
            str(paths["source"]),
            prefix,
        )
        assert Path(prefix).parent.name == "rasters"
        assert Path(prefix).name == f"page-{page:03d}"
    all_reader_commands = [
        command for command in commands if Path(command[0]) == paths["reader"]
    ]
    assert all_reader_commands[0] == (str(paths["reader"]), "--version")
    reader_commands = all_reader_commands[1:]
    assert len(reader_commands) == 11
    for page, command in enumerate(reader_commands, 1):
        raster = f"{render_commands[page - 1][-1]}.png"
        assert command == (
            str(paths["reader"]),
            raster,
            *config["reader"]["arguments"],
            "--tessdata-dir",
            str(Path(config["reader"]["traineddata_path"]).parent),
        )
        assert Path(command[1]).suffix == ".png"
        assert Path(command[1]) != paths["source"]


def test_source_tamper_refuses_without_final_outputs(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    paths["source"].write_bytes(paths["source"].read_bytes() + b"tamper")
    with pytest.raises(OCREmitterError, match="source hash drift"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_tool_drift_refuses_without_final_outputs(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    paths["renderer"].write_text(paths["renderer"].read_text() + "\n# drift\n")
    with pytest.raises(OCREmitterError, match="binary hash drift"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_empty_ocr_refuses_without_final_outputs(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    (paths["reader"].parent / "empty.flag").touch()
    with pytest.raises(OCREmitterError, match="empty OCR response"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_reader_failure_leaves_no_final_outputs(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    (paths["reader"].parent / "fail.flag").touch()
    with pytest.raises(OCREmitterError, match="failed with exit 7"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_existing_output_is_never_overwritten(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    sentinel = b"existing public result"
    paths["bundle"].write_bytes(sentinel)
    with pytest.raises(OCREmitterError, match="refusing to overwrite"):
        emit(root, precommit)
    assert paths["bundle"].read_bytes() == sentinel
    assert not paths["private"].exists()
    assert not paths["verification"].exists()


def test_malformed_language_binding_refuses_without_index_error(tmp_path: Path) -> None:
    root, precommit, paths = _fixture(tmp_path)
    config = json.loads(precommit.read_bytes())
    config["reader"]["arguments"] = ["stdout", "-l"]
    _write_json(precommit, config)
    with pytest.raises(OCREmitterError, match="do not bind reader.language"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


@pytest.mark.parametrize("field", ["profile", "profile_version", "document_version"])
@pytest.mark.parametrize("mode", ["missing", "changed"])
def test_emitted_profile_identity_must_equal_the_precommit(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    field: str,
    mode: str,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    document = Bundle.document

    def drifted(bundle):
        value = document(bundle)
        if mode == "missing":
            value.pop(field)
        else:
            value[field] = 999 if field == "document_version" else "drifted"
        return value

    monkeypatch.setattr(Bundle, "document", drifted)
    message = "key mismatch" if mode == "missing" else "identity drifts from precommit"
    with pytest.raises(OCREmitterError, match=message):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


@pytest.mark.parametrize("failed_output", ["bundle", "verification"])
def test_publication_rename_failure_rolls_back_every_final_output(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    failed_output: str,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    replace_path = Path.replace
    injected = False

    def fail_once(source: Path, target: Path):
        nonlocal injected
        if Path(target) == paths[failed_output] and not injected:
            injected = True
            raise OSError("injected publication failure")
        return replace_path(source, target)

    monkeypatch.setattr(Path, "replace", fail_once)
    with pytest.raises(OCREmitterError, match="publication failed and was rolled back"):
        emit(root, precommit)
    assert injected
    _assert_no_final_outputs(paths)


@pytest.mark.parametrize(
    ("case", "message"),
    [
        ("confidence", "bundle hypotheses drifts"),
        ("reader_identity", "bundle attempts drifts"),
        ("source_class", "bundle source_class drifts"),
        ("transport", "bundle transport_metadata drifts"),
    ],
)
def test_frozen_bundle_fields_are_checked_beyond_the_public_profile(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    case: str,
    message: str,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    build = ocr_emitter._build_bundle

    def drifted(config, artifacts, version):
        bundle = build(config, artifacts, version)
        if case == "confidence":
            hypotheses = list(bundle.hypotheses)
            hypotheses[0] = replace(hypotheses[0], confidence=0.5)
            bundle = replace(bundle, hypotheses=tuple(hypotheses))
        elif case == "reader_identity":
            attempts = list(bundle.attempts)
            attempts[0] = replace(attempts[0], config_identity={"reader_id": "drift"})
            bundle = replace(bundle, attempts=tuple(attempts))
        elif case == "source_class":
            bundle = replace(
                bundle,
                source_class=replace(bundle.source_class, id="source-class:drift"),
            )
        else:
            bundle = replace(bundle, transport_metadata={"adapter": "drift"})
        assert verify_bundle(bundle).conforms
        return bundle

    monkeypatch.setattr(ocr_emitter, "_build_bundle", drifted)
    with pytest.raises(OCREmitterError, match=message):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


@pytest.mark.parametrize(
    ("case", "message"),
    [
        ("locator", "sidecar path or locator drift"),
        ("stage_path", "sidecar path or locator drift"),
        ("request_identity", "request identity drift"),
        ("dimensions", "PNG dimensions drift"),
    ],
)
def test_sidecars_must_match_their_configured_locator_and_stage_file(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    case: str,
    message: str,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    render = ocr_emitter._render_and_read

    def drifted(*args, **kwargs):
        artifacts = list(render(*args, **kwargs))
        if case == "locator":
            artifacts[0] = replace(artifacts[0], raster_locator="private/wrong.png")
        elif case == "stage_path":
            artifacts[0] = replace(artifacts[0], raster_path=artifacts[1].raster_path)
        elif case == "request_identity":
            request = json.loads(artifacts[0].request_path.read_bytes())
            request["reader"]["id"] = "reader:drift"
            request_bytes = (
                json.dumps(
                    request,
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode()
                + b"\n"
            )
            artifacts[0].request_path.write_bytes(request_bytes)
            artifacts[0] = replace(artifacts[0], request_sha256=_digest(request_bytes))
        else:
            artifacts[0] = replace(artifacts[0], width=artifacts[0].width + 1)
        return tuple(artifacts)

    monkeypatch.setattr(ocr_emitter, "_render_and_read", drifted)
    with pytest.raises(OCREmitterError, match=message):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_cross_region_attempt_refuses_without_final_outputs(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    build = ocr_emitter._build_bundle

    def misaligned(config, artifacts, version):
        bundle = build(config, artifacts, version)
        attempts = list(bundle.attempts)
        attempts[0] = replace(attempts[0], region_id=bundle.regions[1].id)
        broken = replace(bundle, attempts=tuple(attempts))
        assert verify_bundle(broken).conforms
        return broken

    monkeypatch.setattr(ocr_emitter, "_build_bundle", misaligned)
    with pytest.raises(OCREmitterError, match="bundle attempts drifts"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)


def test_cross_region_selection_refuses_without_final_outputs(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    root, precommit, paths = _fixture(tmp_path)
    build = ocr_emitter._build_bundle

    def misaligned(config, artifacts, version):
        bundle = build(config, artifacts, version)
        selections = list(bundle.selections)
        selections[0] = replace(selections[0], region_id=bundle.regions[1].id)
        broken = replace(bundle, selections=tuple(selections))
        assert verify_bundle(broken).conforms
        return broken

    monkeypatch.setattr(ocr_emitter, "_build_bundle", misaligned)
    with pytest.raises(OCREmitterError, match="bundle selections drifts"):
        emit(root, precommit)
    _assert_no_final_outputs(paths)
