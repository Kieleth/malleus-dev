            "data_handling": {
                "id": "policy:data-handling:test",
                "classification": "test",
                "processing": "local binaries only",
                "provider_retention": "none",
                "credentials": "forbidden",
                "raw_responses": "private",
                "rasters": "private",
                "public_export": "digests only",
                "full_text_export": "requires review",
            },
            "hostile_content": {
                "id": "policy:hostile-content:test",
                "document_role": "untrusted data",
                "instruction_effect": "none",
                "tool_effect": "none",
                "policy_effect": "none",
                "ontology_effect": "proposal only",
            },
        },
        "retention": {
            "private_root": "private/run",
            "public_bundle": "paper-v4/experiment/ocr-bundle.json",
            "public_verification": "paper-v4/experiment/ocr-verification.json",
            "page_rasters": "private",
            "page_requests": "private",
            "page_responses": "private",
            "selected_reading": "private",
            "bundle_text_bytes": "digest_only",
        },
        "execution": {
            "network": "forbidden",
