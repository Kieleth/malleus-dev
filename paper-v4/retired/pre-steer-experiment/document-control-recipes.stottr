@prefix mgrp: <https://malleus.dev/graph-recipe/base/> .
@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix malleus: <https://malleus.dev/schema/> .
@prefix paper4: <https://malleus.dev/schema/paper-v4-domain-proposal/> .
@prefix recipe: <https://malleus.dev/paper-v4/recipe/> .
@prefix member: <urn:malleus:paper-v4:member:> .

recipe:DocumentControl-1.0.0 [
  ! xsd:string ?networkName,
  ! xsd:integer ?deployedInstrumentCount,
  ! xsd:integer ?usableInstrumentCount,
  ! xsd:string ?campaignName,
  ! xsd:integer ?campaignYear,
  ! xsd:string ?ridgeName,
  ! xsd:string ?earthquakePopulationName,
  ! xsd:string ?meltPopulationName,
  ! ?earthquakeDepthLower,
  ! ?earthquakeDepthUpper,
  ! ?primaryMeltCo2Lower,
  ! ?primaryMeltCo2Upper,
  ! xsd:string ?hypothesisName
] :: {
  mgrp:Record(member:e01-network, mgrp:CreateEntity, paper4:ObservationNetwork, "document:network:smarties-2019"),
  mgrp:Property(member:e01-network, malleus:name, ?networkName),
  mgrp:Property(member:e01-network, paper4:deployed_instrument_count, ?deployedInstrumentCount),
  mgrp:Property(member:e01-network, paper4:usable_instrument_count, ?usableInstrumentCount),

  mgrp:Record(member:e02-campaign, mgrp:CreateEntity, paper4:Campaign, "document:campaign:smarties-2019"),
  mgrp:Property(member:e02-campaign, malleus:name, ?campaignName),
  mgrp:Property(member:e02-campaign, paper4:campaign_year, ?campaignYear),

  mgrp:Record(member:e03-ridge, mgrp:CreateEntity, paper4:RidgeSection, "document:ridge-section:rc2"),
  mgrp:Property(member:e03-ridge, malleus:name, ?ridgeName),

  mgrp:Record(member:e04-earthquakes, mgrp:CreateEntity, paper4:EarthquakePopulation, "document:earthquake-population:deep-microseismicity"),
  mgrp:Property(member:e04-earthquakes, malleus:name, ?earthquakePopulationName),

  mgrp:Record(member:e05-melt, mgrp:CreateEntity, paper4:MeltPopulation, "document:melt-population:rc2-primary-melt"),
  mgrp:Property(member:e05-melt, malleus:name, ?meltPopulationName),

  mgrp:Record(member:e06-depth-range, mgrp:CreateEntity, paper4:QuantitativeRange, "document:range:earthquake-depth"),
  mgrp:Property(member:e06-depth-range, paper4:quantity_kind, "EARTHQUAKE_DEPTH"),
  mgrp:Property(member:e06-depth-range, paper4:lower_bound, ?earthquakeDepthLower),
  mgrp:Property(member:e06-depth-range, paper4:upper_bound, ?earthquakeDepthUpper),
  mgrp:Property(member:e06-depth-range, paper4:unit, "KILOMETER"),
  mgrp:Property(member:e06-depth-range, paper4:epistemic_status, "REPORTED_OBSERVATION"),

  mgrp:Record(member:e07-co2-range, mgrp:CreateEntity, paper4:QuantitativeRange, "document:range:primary-melt-co2"),
  mgrp:Property(member:e07-co2-range, paper4:quantity_kind, "PRIMARY_MELT_CO2_CONCENTRATION"),
  mgrp:Property(member:e07-co2-range, paper4:lower_bound, ?primaryMeltCo2Lower),
  mgrp:Property(member:e07-co2-range, paper4:upper_bound, ?primaryMeltCo2Upper),
  mgrp:Property(member:e07-co2-range, paper4:unit, "WEIGHT_PERCENT"),
  mgrp:Property(member:e07-co2-range, paper4:epistemic_status, "CALCULATED_ESTIMATE"),

  mgrp:Record(member:e08-hypothesis, mgrp:CreateEntity, paper4:CausalHypothesis, "document:hypothesis:co2-degassing"),
  mgrp:Property(member:e08-hypothesis, malleus:name, ?hypothesisName),
  mgrp:Property(member:e08-hypothesis, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),

  mgrp:Record(member:e09-ascending-melt, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:ascending-melt"),
  mgrp:Property(member:e09-ascending-melt, paper4:mechanism_kind, "ASCENDING_MELT"),
  mgrp:Record(member:e10-co2-degassing, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:co2-degassing"),
  mgrp:Property(member:e10-co2-degassing, paper4:mechanism_kind, "CARBON_DIOXIDE_DEGASSING"),
  mgrp:Record(member:e11-volume-change, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:volume-change"),
  mgrp:Property(member:e11-volume-change, paper4:mechanism_kind, "VOLUME_CHANGE"),
  mgrp:Record(member:e12-pressure-increase, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:pressure-increase"),
  mgrp:Property(member:e12-pressure-increase, paper4:mechanism_kind, "PRESSURE_INCREASE"),
  mgrp:Record(member:e13-extensional-stress, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:extensional-stress"),
  mgrp:Property(member:e13-extensional-stress, paper4:mechanism_kind, "EXTENSIONAL_STRESS"),
  mgrp:Record(member:e14-high-strain-rate, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:high-strain-rate"),
  mgrp:Property(member:e14-high-strain-rate, paper4:mechanism_kind, "LOCAL_HIGH_STRAIN_RATE"),
  mgrp:Record(member:e15-earthquake-triggering, mgrp:CreateEntity, paper4:MechanismElement, "document:mechanism:earthquake-triggering"),
  mgrp:Property(member:e15-earthquake-triggering, paper4:mechanism_kind, "EARTHQUAKE_TRIGGERING"),

  mgrp:Record(member:r01-acquisition, mgrp:CreateRelation, paper4:DataAcquisitionRelation, "document:relation:acquisition:network-smarties"),
  mgrp:Property(member:r01-acquisition, malleus:relation_type, "ACQUIRED_DURING"),
  mgrp:Property(member:r01-acquisition, paper4:data_kind, "MICROSEISMICITY"),
  mgrp:Property(member:r01-acquisition, paper4:epistemic_status, "REPORTED_OBSERVATION"),
  mgrp:RelationSource(member:r01-acquisition, "document:network:smarties-2019"),
  mgrp:RelationTarget(member:r01-acquisition, "document:campaign:smarties-2019"),
  mgrp:DependsOn(member:r01-acquisition, member:e01-network),
  mgrp:DependsOn(member:r01-acquisition, member:e02-campaign),

  mgrp:Record(member:r02-spatial-earthquakes, mgrp:CreateRelation, paper4:SpatialAssociationRelation, "document:relation:spatial:earthquakes-rc2"),
  mgrp:Property(member:r02-spatial-earthquakes, malleus:relation_type, "SPATIALLY_ASSOCIATED_WITH"),
  mgrp:Property(member:r02-spatial-earthquakes, paper4:relative_position, "BENEATH_RIDGE_AXIS"),
  mgrp:Property(member:r02-spatial-earthquakes, paper4:epistemic_status, "REPORTED_OBSERVATION"),
  mgrp:RelationSource(member:r02-spatial-earthquakes, "document:earthquake-population:deep-microseismicity"),
  mgrp:RelationTarget(member:r02-spatial-earthquakes, "document:ridge-section:rc2"),
  mgrp:DependsOn(member:r02-spatial-earthquakes, member:e04-earthquakes),
  mgrp:DependsOn(member:r02-spatial-earthquakes, member:e03-ridge),

  mgrp:Record(member:r03-spatial-melt, mgrp:CreateRelation, paper4:SpatialAssociationRelation, "document:relation:spatial:melt-rc2"),
  mgrp:Property(member:r03-spatial-melt, malleus:relation_type, "SPATIALLY_ASSOCIATED_WITH"),
  mgrp:Property(member:r03-spatial-melt, paper4:relative_position, "ALONG_RIDGE_SECTION"),
  mgrp:Property(member:r03-spatial-melt, paper4:epistemic_status, "REPORTED_OBSERVATION"),
  mgrp:RelationSource(member:r03-spatial-melt, "document:melt-population:rc2-primary-melt"),
  mgrp:RelationTarget(member:r03-spatial-melt, "document:ridge-section:rc2"),
  mgrp:DependsOn(member:r03-spatial-melt, member:e05-melt),
  mgrp:DependsOn(member:r03-spatial-melt, member:e03-ridge),

  mgrp:Record(member:r04-quantity-depth, mgrp:CreateRelation, paper4:QuantitySubjectRelation, "document:relation:quantity:earthquake-depth"),
  mgrp:Property(member:r04-quantity-depth, malleus:relation_type, "HAS_QUANTITY"),
  mgrp:RelationSource(member:r04-quantity-depth, "document:earthquake-population:deep-microseismicity"),
  mgrp:RelationTarget(member:r04-quantity-depth, "document:range:earthquake-depth"),
  mgrp:DependsOn(member:r04-quantity-depth, member:e04-earthquakes),
  mgrp:DependsOn(member:r04-quantity-depth, member:e06-depth-range),

  mgrp:Record(member:r05-quantity-co2, mgrp:CreateRelation, paper4:QuantitySubjectRelation, "document:relation:quantity:melt-co2"),
  mgrp:Property(member:r05-quantity-co2, malleus:relation_type, "HAS_QUANTITY"),
  mgrp:RelationSource(member:r05-quantity-co2, "document:melt-population:rc2-primary-melt"),
  mgrp:RelationTarget(member:r05-quantity-co2, "document:range:primary-melt-co2"),
  mgrp:DependsOn(member:r05-quantity-co2, member:e05-melt),
  mgrp:DependsOn(member:r05-quantity-co2, member:e07-co2-range),

  mgrp:Record(member:r06-component-ascending-melt, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:ascending-melt"),
  mgrp:Property(member:r06-component-ascending-melt, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r06-component-ascending-melt, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r06-component-ascending-melt, "document:mechanism:ascending-melt"),
  mgrp:DependsOn(member:r06-component-ascending-melt, member:e08-hypothesis),
  mgrp:DependsOn(member:r06-component-ascending-melt, member:e09-ascending-melt),
  mgrp:Record(member:r07-component-co2-degassing, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:co2-degassing"),
  mgrp:Property(member:r07-component-co2-degassing, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r07-component-co2-degassing, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r07-component-co2-degassing, "document:mechanism:co2-degassing"),
  mgrp:DependsOn(member:r07-component-co2-degassing, member:e08-hypothesis),
  mgrp:DependsOn(member:r07-component-co2-degassing, member:e10-co2-degassing),
  mgrp:Record(member:r08-component-volume-change, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:volume-change"),
  mgrp:Property(member:r08-component-volume-change, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r08-component-volume-change, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r08-component-volume-change, "document:mechanism:volume-change"),
  mgrp:DependsOn(member:r08-component-volume-change, member:e08-hypothesis),
  mgrp:DependsOn(member:r08-component-volume-change, member:e11-volume-change),
  mgrp:Record(member:r09-component-pressure-increase, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:pressure-increase"),
  mgrp:Property(member:r09-component-pressure-increase, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r09-component-pressure-increase, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r09-component-pressure-increase, "document:mechanism:pressure-increase"),
  mgrp:DependsOn(member:r09-component-pressure-increase, member:e08-hypothesis),
  mgrp:DependsOn(member:r09-component-pressure-increase, member:e12-pressure-increase),
  mgrp:Record(member:r10-component-extensional-stress, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:extensional-stress"),
  mgrp:Property(member:r10-component-extensional-stress, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r10-component-extensional-stress, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r10-component-extensional-stress, "document:mechanism:extensional-stress"),
  mgrp:DependsOn(member:r10-component-extensional-stress, member:e08-hypothesis),
  mgrp:DependsOn(member:r10-component-extensional-stress, member:e13-extensional-stress),
  mgrp:Record(member:r11-component-high-strain-rate, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:high-strain-rate"),
  mgrp:Property(member:r11-component-high-strain-rate, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r11-component-high-strain-rate, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r11-component-high-strain-rate, "document:mechanism:high-strain-rate"),
  mgrp:DependsOn(member:r11-component-high-strain-rate, member:e08-hypothesis),
  mgrp:DependsOn(member:r11-component-high-strain-rate, member:e14-high-strain-rate),
  mgrp:Record(member:r12-component-earthquake-triggering, mgrp:CreateRelation, paper4:HypothesisComponentRelation, "document:relation:component:earthquake-triggering"),
  mgrp:Property(member:r12-component-earthquake-triggering, malleus:relation_type, "HAS_COMPONENT"),
  mgrp:RelationSource(member:r12-component-earthquake-triggering, "document:hypothesis:co2-degassing"),
  mgrp:RelationTarget(member:r12-component-earthquake-triggering, "document:mechanism:earthquake-triggering"),
  mgrp:DependsOn(member:r12-component-earthquake-triggering, member:e08-hypothesis),
  mgrp:DependsOn(member:r12-component-earthquake-triggering, member:e15-earthquake-triggering),

  mgrp:Record(member:r13-causal-melt-degassing, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:melt-degassing"),
  mgrp:Property(member:r13-causal-melt-degassing, malleus:relation_type, "CAUSES"),
  mgrp:Property(member:r13-causal-melt-degassing, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),
  mgrp:RelationSource(member:r13-causal-melt-degassing, "document:mechanism:ascending-melt"),
  mgrp:RelationTarget(member:r13-causal-melt-degassing, "document:mechanism:co2-degassing"),
  mgrp:DependsOn(member:r13-causal-melt-degassing, member:e09-ascending-melt),
  mgrp:DependsOn(member:r13-causal-melt-degassing, member:e10-co2-degassing),
  mgrp:Record(member:r14-causal-degassing-volume, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:degassing-volume"),
  mgrp:Property(member:r14-causal-degassing-volume, malleus:relation_type, "CAUSES"),
  mgrp:Property(member:r14-causal-degassing-volume, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),
  mgrp:RelationSource(member:r14-causal-degassing-volume, "document:mechanism:co2-degassing"),
  mgrp:RelationTarget(member:r14-causal-degassing-volume, "document:mechanism:volume-change"),
  mgrp:DependsOn(member:r14-causal-degassing-volume, member:e10-co2-degassing),
  mgrp:DependsOn(member:r14-causal-degassing-volume, member:e11-volume-change),
  mgrp:Record(member:r15-causal-degassing-pressure, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:degassing-pressure"),
  mgrp:Property(member:r15-causal-degassing-pressure, malleus:relation_type, "CAUSES"),
  mgrp:Property(member:r15-causal-degassing-pressure, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),
  mgrp:RelationSource(member:r15-causal-degassing-pressure, "document:mechanism:co2-degassing"),
  mgrp:RelationTarget(member:r15-causal-degassing-pressure, "document:mechanism:pressure-increase"),
  mgrp:DependsOn(member:r15-causal-degassing-pressure, member:e10-co2-degassing),
  mgrp:DependsOn(member:r15-causal-degassing-pressure, member:e12-pressure-increase),
  mgrp:Record(member:r16-causal-volume-strain, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:volume-strain"),
