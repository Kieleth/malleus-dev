  mgrp:DependsOn(member:r17-causal-stress-strain, member:e13-extensional-stress),
  mgrp:DependsOn(member:r17-causal-stress-strain, member:e14-high-strain-rate),
  mgrp:Record(member:r18-causal-pressure-trigger, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:pressure-trigger"),
  mgrp:Property(member:r18-causal-pressure-trigger, malleus:relation_type, "CAUSES"),
  mgrp:Property(member:r18-causal-pressure-trigger, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),
  mgrp:RelationSource(member:r18-causal-pressure-trigger, "document:mechanism:pressure-increase"),
  mgrp:RelationTarget(member:r18-causal-pressure-trigger, "document:mechanism:earthquake-triggering"),
  mgrp:DependsOn(member:r18-causal-pressure-trigger, member:e12-pressure-increase),
  mgrp:DependsOn(member:r18-causal-pressure-trigger, member:e15-earthquake-triggering),
  mgrp:Record(member:r19-causal-strain-trigger, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:strain-trigger"),
  mgrp:Property(member:r19-causal-strain-trigger, malleus:relation_type, "CAUSES"),
  mgrp:Property(member:r19-causal-strain-trigger, paper4:epistemic_status, "PREFERRED_HYPOTHESIS"),
  mgrp:RelationSource(member:r19-causal-strain-trigger, "document:mechanism:high-strain-rate"),
