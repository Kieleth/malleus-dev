  mgrp:DependsOn(member:r19-causal-strain-trigger, member:e14-high-strain-rate),
  mgrp:DependsOn(member:r19-causal-strain-trigger, member:e15-earthquake-triggering),

  mgrp:Record(member:r20-hypothesis-target, mgrp:CreateRelation, paper4:HypothesisTargetRelation, "document:relation:target:hypothesis-earthquakes"),
  mgrp:Property(member:r20-hypothesis-target, malleus:relation_type, "EXPLAINS"),
  mgrp:RelationSource(member:r20-hypothesis-target, "document:hypothesis:co2-degassing"),
