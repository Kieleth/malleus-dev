  mgrp:DependsOn(member:r16-causal-volume-strain, member:e11-volume-change),
  mgrp:DependsOn(member:r16-causal-volume-strain, member:e14-high-strain-rate),
  mgrp:Record(member:r17-causal-stress-strain, mgrp:CreateRelation, paper4:CausalLinkRelation, "document:relation:causal:stress-strain"),
  mgrp:Property(member:r17-causal-stress-strain, malleus:relation_type, "CAUSES"),
