recipe:QuantitativeObservation-1.0.0 [
  ! ottr:IRI ?member,
  ! xsd:string ?recordId,
  ! xsd:string ?name,
  ! xsd:string ?quantityKind,
  ! ?lowerNumericValue,
  ! ?upperNumericValue,
  ! xsd:string ?measurementUnit,
  ! xsd:string ?observationBasis
] :: {
  mgrp:Record(?member, mgrp:CreateEntity, morg:QuantitativeObservation, ?recordId),
  mgrp:Property(?member, malleus:name, ?name),
  mgrp:Property(?member, morg:quantity_kind, ?quantityKind),
  mgrp:Property(?member, morg:lower_numeric_value, ?lowerNumericValue),
  mgrp:Property(?member, morg:upper_numeric_value, ?upperNumericValue),
  mgrp:Property(?member, morg:measurement_unit, ?measurementUnit),
  mgrp:Property(?member, morg:observation_basis, ?observationBasis)
} .

