    "changes_since_v4": [
      {
        "id": "SKILL_REVISED",
        "subject": ".claude/skills/malleus-acolyte/SKILL.md",
        "revisions": [
          "GROUNDING_BLOCK_EXAMPLE",
          "READING_BYTES_FACT",
          "DERIVATION_RULE",
          "EVENTS_ENVELOPE",
          "LOCATOR_WORDING",
          "QUANTITY_KIND_CLASS_AND_CLAIM_LOCATOR_RULES"
        ],
        "detail": "The skill shows the grounding annotation in the shape the rite closes and states the three closed field sets; it states that reading_bytes are the raw declared input bytes and that the adapter never re-serialises them; it states that every properties key and both relation endpoints need a derivation while type and id do not; the capture template carries an events envelope beside entities and relations with the admission rule; it says which provenance locators leave the domain ontology and which source-reported identifiers stay; and it states the metrology quantity-kind class and the research claim locator and statement-digest rules.",
        "why": "E-0122 findings 1, 2, 3 and 5 and E-0124's finding. Three fresh producers spent their diagnostic budget discovering the grounding block's shape and the capture interface by refusal rather than by reading."
      },
      {
        "id": "PACKS_REVISED",
        "subject": "ontology/packs/metrology.yaml, ontology/packs/research.yaml",
        "versions": {
          "metrology": "0.2.0",
          "research": "0.2.0"
        },
        "detail": "metrology seeds enum QuantityKindClass, fifteen QUDT quantity-kind names plus a local OTHER, and the optional quantity_kind_class slot on the Quantified mixin beside the open quantity_kind, which keeps the source's own wording. research puts assertion_locator and statement_sha256 on the SourceAsserted mixin, reaching Claim and Observation, and gives Source a licence. Both edits are additive at 0.2.0.",
        "why": "Run-02 wrote 137 distinct strings into the open quantity_kind, so a type-only binding could not sharpen, and put verbatim source sentences in Claim.statement, which withheld seven otherwise public artifacts."
      },
      {
        "id": "CORE_AGGREGATED_DIAGNOSTICS",
        "subject": "src/malleus/inquisition/pack_grounding.py, src/malleus/_contract_pipeline/population.py",
        "governance_entry": "OVR-000395",
        "reasons": [
          "DIRECT_ROOT_GROUNDING_REQUIRED",
          "GROUNDING_NOT_CLOSED",
          "GROUNDING_INCOMPLETE",
          "UNDERIVED_FIELD"
        ],
        "detail": "The pack-grounding rite reports every ill-formed grounding block and entry in one sorted refusal, each item naming its subject, its entry index and the closed field set that position requires. The plan compiler reports every underived field in one UNDERIVED_FIELD refusal with the rule that closes them. Before this, only the missing-root case aggregated.",
        "why": "E-0124. One shape defect per refusal spent run-03's whole two-return budget on one grounding block's shape, and E-0122 finding 2 recorded the same failure class one layer down."
      },
      {
        "id": "POPULATION_SURFACE_LISTS_EVENTS",
        "subject": "paper-v4/experiment-v4/run-04/compile_ontology_candidate.py",
        "surface_schema": "malleus.paper-v4.population-surface/v2",
        "prior_surface_schema": "malleus.paper-v4.population-surface/v1",
        "defect_of": "run-02",
        "detail": "The population surface handed to the producer now lists every concrete type that subtypes the Malleus Event root under family EVENT, and concrete EventParticipation types under family EVENT_PARTICIPATION when the compiled contract declares that type, with the same effective slots and enum values entities and relations already carried. The surface also carries families_admitted, derived from the bound source-assertion profile.",
        "why": "E-0122 finding 3. Run-02's accepted surface enumerated 26 ENTITY and 3 RELATION types and no EVENT type, although the accepted ontology declared SeismicEvent extending Event, the grounding receipt listed it among the grounded subjects, and the bound profile admits events. The producer wrote seven TYPE_ABSENT gaps instead of Event records. This is a paper-harness defect, not a Core one."
      }
    ]
  },
