  mgrp:Property(?member, osc:analyte_symbol, ?analyteSymbol),
  mgrp:Property(?member, osc:analyte_kind, ?analyteKind),
  mgrp:Property(?member, osc:concentration_value, ?concentrationValue),
  mgrp:Property(?member, osc:concentration_unit, ?concentrationUnit),
  mgrp:Property(?member, osc:determination_mode, ?determinationMode)
} .

