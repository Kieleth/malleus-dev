  ! ottr:IRI ?member,
  ! xsd:string ?recordId,
  ! xsd:string ?analyteSymbol,
  ! ?pressure,
  ! ?temperature
] :: {
  mgrp:Record(?member, mgrp:CreateEntity, osc:VolatileSaturationCondition, ?recordId),
  mgrp:Property(?member, osc:analyte_symbol, ?analyteSymbol),
  mgrp:Property(?member, osc:pressure, ?pressure),
  mgrp:Property(?member, osc:temperature, ?temperature)
} .

recipe:DeployedInRelation-1.0.0 [
  ! ottr:IRI ?member,
  ! xsd:string ?recordId,
  ! ottr:IRI ?sourceMember,
  ! xsd:string ?sourceId,
  ! ottr:IRI ?targetMember,
  ! xsd:string ?targetId
] :: {
  mgrp:Record(?member, mgrp:CreateRelation, osc:DeployedInRelation, ?recordId),
  mgrp:Property(?member, malleus:relation_type, "DEPLOYED_IN"),
  mgrp:RelationSource(?member, ?sourceId),
  mgrp:RelationTarget(?member, ?targetId),
  mgrp:DependsOn(?member, ?sourceMember),
  mgrp:DependsOn(?member, ?targetMember)
} .

